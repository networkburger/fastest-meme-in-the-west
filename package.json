{
  "name": "fastest-meme-in-the-west",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build && node scripts/budget.mjs",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "measure": "vite build && node scripts/measure.mjs",
    "budget": "node scripts/budget.mjs",
    "fonts": "node scripts/build-fonts.mjs",
    "thumbs": "node scripts/build-thumbs.mjs"
  },
  "dependencies": {
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "image-size": "^2.1.0",
    "preact-render-to-string": "^6.8.3",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
